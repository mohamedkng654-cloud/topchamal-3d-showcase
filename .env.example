# Supabase project settings — replace these placeholders locally.
# Never commit a real service-role key or admin password.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Legacy projects may use this name instead:
# VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-only secret. Keep this out of VITE_* variables and out of browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Optional server-only OpenAI configuration for the admin product assistant.
# Add the real key in deployment secrets, never in client-side VITE_* variables.
OPENAI_API_KEY=YOUR_SERVER_ONLY_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini
# Optional: use an OpenAI-compatible gateway instead of api.openai.com.
# OPENAI_API_BASE=https://api.openai.com/v1
