# Supabase project settings — replace these placeholders locally.
# Never commit a real service-role key or admin password.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-only secret. Keep this out of VITE_* variables and out of browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
